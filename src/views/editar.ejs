<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar <%= tipo %> - DegustaUTF</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/sketchy/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: var(--bs-body-bg); padding-top: 50px; }
        .theme-toggle { 
            position: fixed; top: 20px; right: 20px; cursor: pointer; z-index: 2000; 
            width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;
            border-radius: 50%; border: 2px solid #000 !important; background-color: #000; color: #ffc107;
        }
        .edit-card { max-width: 600px; margin: auto; border-width: 2px; }
    </style>
</head>
<body>
    <div class="theme-toggle shadow" id="themeBtn"><i class="bi bi-moon-stars-fill" id="themeIcon"></i></div>
    <div class="container">
        <div class="card edit-card shadow-lg border-dark">
            <div class="card-header bg-warning text-dark border-bottom border-dark border-2">
                <h2 class="mb-0 fw-bold">Editar <%= tipo %></h2>
            </div>
            <div class="card-body p-4">
                <form action="<%= acao %>" method="POST">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Nome:</label>
                        <input type="text" name="nome" value="<%= item.nome %>" class="form-control border-2" required>
                    </div>

                    <% if (tipo === 'Aluno') { %>
                        <div class="mb-4">
                            <label class="form-label fw-bold">E-mail:</label>
                            <input type="email" name="email" value="<%= item.email %>" class="form-control border-2" required>
                        </div>
                        
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input border-dark" type="checkbox" name="eh_admin" id="editAdmin" 
                                       <%= item.eh_admin ? 'checked' : '' %>>
                                <label class="form-check-label fw-bold text-danger" for="editAdmin">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Conceder privilégios de Administrador
                                </label>
                            </div>
                        </div>
                    <% } %>

                    <div class="d-flex justify-content-between">
                        <a href="/admin/dashboard" class="btn btn-outline-danger border-2 fw-bold">Cancelar</a>
                        <button type="submit" class="btn btn-warning border-dark border-2 fw-bold">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="/js/theme.js"></script>
</body>
</html>