<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Receita - DegustaUTF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        /* Estilos para imitar a borda desenhada e o padrão do seu projeto */
        .card-custom {
            border: 2px solid #333;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 4px 4px 0px rgba(0,0,0,0.1); /* Sombra para dar destaque */
        }
        .card-header-custom {
            background-color: #ffc107; /* O mesmo amarelo do seu menu */
            border-bottom: 2px solid #333;
            padding: 10px 15px;
            font-weight: bold;
            color: #333;
        }
        .input-custom {
            border: 2px solid #333;
            border-radius: 8px;
        }
        .input-custom:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
        }
        .btn-custom {
            background-color: #555; /* Cinza escuro dos seus botões */
            color: white;
            border: 2px solid #333;
            border-radius: 8px;
            font-weight: bold;
        }
        .btn-custom:hover {
            background-color: #333;
            color: white;
        }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg bg-warning mb-4 shadow-sm" style="border-bottom: 2px solid #333;">
        <div class="container">
            <span class="navbar-brand fw-bold text-dark h2 mb-0">DegustaUTF Admin</span>
            <div class="d-flex align-items-center">
                <a href="/portal" class="btn btn-outline-dark btn-sm border-2 fw-bold me-3 shadow-sm">
                    <i class="bi bi-eye-fill me-1"></i> Ver Portal
                </a>
                <a href="/receitas/nova" class="btn btn-outline-dark btn-sm border-2 fw-bold me-3 shadow-sm">
                    <i class="bi bi-plus-circle-fill me-1"></i> Nova Receita
                </a>
                <span class="me-3 fw-bold">Olá, <%= usuarioLogado ? usuarioLogado.nome : 'Chefe' %>!</span>
                <a href="/logout" class="btn btn-dark btn-sm border-2 fw-bold shadow-sm">Sair</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        
        <div class="card card-custom mb-4 mx-auto" style="max-width: 900px;">
            <div class="card-header card-header-custom">
                Cadastrar Nova Receita
            </div>
            <div class="card-body p-4">
                <form action="/receitas/cadastrar" method="POST">
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <input type="text" name="nome" class="form-control input-custom" placeholder="Nome da Receita" required>
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <input type="url" name="midia_url" class="form-control input-custom" placeholder="Link do Vídeo ou Imagem (Opcional)">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <textarea name="descricao" class="form-control input-custom" rows="5" placeholder="Modo de Preparo e Ingredientes..." required></textarea>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Categorias (Segure CTRL para selecionar várias)</label>
                            <select name="categorias" class="form-select input-custom" multiple required style="height: 120px;">
                                <% categorias.forEach(cat => { %>
                                    <option value="<%= cat.id %>"><%= cat.nome %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <label class="form-label fw-bold small text-dark">Coautores (Opcional)</label>
                            <select name="autores" class="form-select input-custom" multiple style="height: 120px;">
                                <% alunos.forEach(aluno => { %>
                                    <% if(usuarioLogado && aluno.id !== usuarioLogado.id) { %>
                                        <option value="<%= aluno.id %>"><%= aluno.nome %></option>
                                    <% } %>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-3 mt-2">
                        <a href="/portal" class="btn btn-light border-2 border-dark fw-bold me-2" style="border-radius: 8px;">Cancelar</a>
                        <button type="submit" class="btn btn-custom px-5">Publicar</button>
                    </div>
                </form>
            </div>
        </div>

    </div>

</body>
</html>