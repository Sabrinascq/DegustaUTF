<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Degusta - Cursos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/sketchy/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: var(--bs-body-bg); padding-bottom: 0; }
        
        .theme-toggle { 
            position: fixed; top: 20px; right: 20px; cursor: pointer; z-index: 2000; 
            width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;
            border-radius: 50%; border: 2px solid #000 !important; transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3); background-color: #000; color: #ffc107;
        }

        .hero-section { 
            background-color: #ffc107; border-bottom: 3px solid #000; 
            padding: 80px 0 60px 0; margin-bottom: 40px; 
        }

        .search-container {
            max-width: 600px; margin: -30px auto 40px auto; position: relative; z-index: 10;
        }

        .card-categoria { 
            transition: transform 0.3s; border-width: 2px; border-color: #000; height: 100%;
        }
        .card-categoria:hover { transform: translateY(-10px) rotate(1deg); }

        [data-bs-theme="dark"] .card-categoria { border-color: #fff; }
        
        footer { background-color: #212529; color: white; padding: 40px 0; margin-top: 60px; border-top: 3px solid #ffc107; }
    </style>
</head>
<body>

    <div class="theme-toggle shadow" id="themeBtn">
        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
    </div>

    <header class="hero-section text-center">
        <div class="container">
            <h1 class="display-3 fw-bold text-dark">Degusta UTF</h1>
            <p class="lead text-dark fw-bold">O que vamos explorar hoje? Escolha uma categoria abaixo!</p>
            <div class="mt-4">
                <a href="/login" class="btn btn-dark border-2 fw-bold px-4 py-2 shadow">
                    <i class="bi bi-person-badge me-2"></i>Área Restrita
                </a>
            </div>
        </div>
    </header>

    <div class="container search-container">
        <div class="input-group input-group-lg shadow-lg">
            <span class="input-group-text bg-white border-2 border-dark border-end-0">
                <i class="bi bi-search text-dark"></i>
            </span>
            <input type="text" id="inputPesquisa" class="form-control border-2 border-dark border-start-0" 
                   placeholder="Pesquisar categoria (ex: Massas, Carnes...)" onkeyup="filtrarCategorias()">
        </div>
    </div>

    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold d-inline-block border-bottom border-3 border-warning pb-2">NOSSAS CATEGORIAS</h2>
        </div>
        
        <div class="row g-4" id="listaCategorias">
            <% categorias.forEach(cat => { %>
                <div class="col-md-4 item-categoria">
                    <div class="card card-categoria shadow">
                        <div class="card-body text-center p-4">
                            <div class="display-5 text-warning mb-3">
                                <i class="bi bi-egg-fried"></i>
                            </div>
                            <h4 class="card-title fw-bold mb-4 nome-cat"><%= cat.nome %></h4>
                            <a href="/portal/categoria/<%= cat.id %>" class="btn btn-warning border-dark border-2 fw-bold w-100">
                                Ver Comentários <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <footer>
        <div class="container text-center">
            <h5 class="fw-bold mb-3">DegustaUTF</h5>
            <p class="small mb-0 text-secondary">Projeto desenvolvido para avaliação acadêmica.</p>
            <p class="small text-secondary">UTFPR - 2024</p>
        </div>
    </footer>

    <script>
        // Função de Pesquisa em Tempo Real
        function filtrarCategorias() {
            let input = document.getElementById('inputPesquisa').value.toLowerCase();
            let cards = document.getElementsByClassName('item-categoria');
            
            for (let i = 0; i < cards.length; i++) {
                let nome = cards[i].querySelector('.nome-cat').innerText.toLowerCase();
                if (nome.includes(input)) {
                    cards[i].style.display = "";
                } else {
                    cards[i].style.display = "none";
                }
            }
        }

        // Script do Tema
        const btn = document.getElementById('themeBtn');
        const icon = document.getElementById('themeIcon');
        const html = document.documentElement;

        btn.addEventListener('click', () => {
            if (html.getAttribute('data-bs-theme') === 'light') {
                html.setAttribute('data-bs-theme', 'dark');
                icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                btn.style.backgroundColor = '#ffc107'; btn.style.color = '#000'; btn.style.borderColor = '#fff';
            } else {
                html.setAttribute('data-bs-theme', 'light');
                icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                btn.style.backgroundColor = '#000'; btn.style.color = '#ffc107'; btn.style.borderColor = '#000';
            }
        });
    </script>
</body>
</html>