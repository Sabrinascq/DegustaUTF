<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatório de Habilidades - DegustaUTF</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/sketchy/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: var(--bs-body-bg); padding-bottom: 50px; }
        .navbar { border-bottom: 3px solid #000; }
        .card-relatorio { border-width: 3px; border-color: #000; }
        .progress { 
            height: 30px; 
            border: 2px solid #000; 
            background-color: #fff; 
            border-radius: 0; 
        }
        .progress-bar { 
            font-weight: bold; 
            color: #000; 
            text-shadow: 1px 1px 0px #fff;
        }
        [data-bs-theme="dark"] .card-relatorio { border-color: #fff; }
        [data-bs-theme="dark"] .progress { background-color: #444; border-color: #fff; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg bg-warning mb-5 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark" href="/portal">
                <i class="bi bi-arrow-left-circle-fill me-2"></i> Voltar ao Portal
            </a>
            <span class="navbar-text fw-bold text-dark h4 mb-0">Relatório de Habilidades</span>
        </div>
    </nav>

    <div class="container">
        <div class="card card-relatorio shadow-lg">
            <div class="card-header bg-dark text-white p-4">
                <h2 class="fw-bold mb-0">Domínio Técnico dos Alunos</h2>
                <p class="mb-0 small">Proporção de alunos por habilidade cadastrada no sistema.</p>
            </div>
            <div class="card-body p-4">
                
                <% if (relatorio.length === 0) { %>
                    <div class="alert alert-info border-2 border-dark fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Ainda não existem habilidades ou vínculos cadastrados para gerar o relatório.
                    </div>
                <% } else { %>
                    <% relatorio.forEach(item => { %>
                        <div class="mb-5">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="fw-bold mb-0"><%= item.nome %></h4>
                                <span class="badge bg-warning text-dark border border-dark border-2 fs-6">
                                    <%= item.porcentagem %>% dos Alunos
                                </span>
                            </div>
                            <div class="progress shadow-sm">
                                <div class="progress-bar bg-warning progress-bar-striped progress-bar-animated" 
                                     role="progressbar" 
                                     style="width: <%= item.porcentagem %>%" 
                                     aria-valuenow="<%= item.porcentagem %>" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>

            </div>
            <div class="card-footer bg-light text-center py-3 border-top border-dark border-2">
                <small class="fw-bold text-muted">Dados atualizados em tempo real - UTFPR Cornélio Procópio</small>
            </div>
        </div>
    </div>

    <script src="/js/theme.js"></script>
</body>
</html>