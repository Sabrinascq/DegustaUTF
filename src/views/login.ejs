<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - DegustaUTF</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/sketchy/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: var(--bs-body-bg);
        }
        
        /* Botão do Tema Padronizado (Lua Amarela / Fundo Preto) */
        .theme-toggle { 
            position: fixed; top: 20px; right: 20px; cursor: pointer; z-index: 2000; 
            width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;
            border-radius: 50%; border: 2px solid #000 !important; transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3); background-color: #000; color: #ffc107;
        }
        .theme-toggle:hover { transform: scale(1.1); }

        .login-card {
            width: 100%;
            max-width: 400px;
            border-width: 2px;
        }
    </style>
</head>
<body>

    <div class="theme-toggle shadow" id="themeBtn">
        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
    </div>

    <div class="container d-flex justify-content-center">
        <div class="card login-card shadow-lg border-dark">
            <div class="card-header bg-warning text-dark text-center py-3 border-bottom border-dark border-2">
                <h3 class="mb-0 fw-bold text-uppercase">DegustaUTF</h3>
                <small class="fw-bold">Acesso Administrativo</small>
            </div>
            
            <div class="card-body p-4">
                <% if (erro) { %>
                    <div class="alert alert-danger border-2 py-2 text-center" role="alert">
                        <strong>Erro:</strong> <%= erro %>
                    </div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label for="email" class="form-label fw-bold small">E-mail</label>
                        <input type="email" id="email" name="email" class="form-control border-2 shadow-sm" placeholder="seu@email.com" required>
                    </div>
                    
                    <div class="mb-4">
                        <label for="senha" class="form-label fw-bold small">Senha</label>
                        <input type="password" id="senha" name="senha" class="form-control border-2 shadow-sm" placeholder="Sua senha" required>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold py-2 border-dark border-2 shadow">
                        ENTRAR NO SISTEMA <i class="bi bi-box-arrow-in-right ms-2"></i>
                    </button>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light border-top border-dark">
                <a href="/portal" class="text-decoration-none text-dark fw-bold small">← Voltar ao Portal</a>
            </div>
        </div>
    </div>

    <script src="/js/theme.js"></script>
</body>
</html>